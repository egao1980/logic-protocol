(in-package #:logic-protocol/tests)

(deftest-parametrize term-kinds
    ((x variable constant)
     ('?x t nil)
     ('?who t nil)
     (:?x nil t)
     ('? nil t)
     ('x nil t)
     (:email nil t)
     ("?x" nil t)
     ("" nil t)
     (0 nil t)
     (-42 nil t)
     (nil nil nil)
     (1.5 nil nil)
     ('(f 1) nil nil))
  (ok (eq (and (logic-variable-p x) t) variable))
  (ok (eq (and (logic-constant-p x) t) constant))
  (ok (eq (and (logic-term-p x) t) (or variable constant))))

(deftest-parametrize atom-shapes
    ((x atom ground)
     ('(edge 1 2) t t)
     ('(moved) t t)
     ('(value :email "a@b.c") t t)
     ('(edge ?x 2) t nil)
     ('(:enabled :submit) t t)
     ('(edge (f 1) 2) nil nil)
     ('(?r 1) nil nil)
     ('(not (p 1)) nil nil)
     ('(next (p 1)) nil nil)
     ('(glob "a" "b") nil nil)
     ('(edge 1 . 2) nil nil)
     ('("edge" 1) nil nil)
     ('(nil 1) nil nil)
     ('edge nil nil)
     (nil nil nil))
  (ok (eq (and (logic-atom-p x) t) atom))
  (ok (eq (and (ground-atom-p x) t) ground)))

(deftest atom-helpers
  (ok (eq (atom-relation '(edge 1 2)) 'edge))
  (ok (equal (atom-args '(edge 1 2)) '(1 2)))
  (ok (equal (atom-variables '(p ?x ?y ?x 3)) '(?x ?y)))
  (ok (equal (atom-variables '((q ?b) (not (r ?a ?b)) (< ?c 1))) '(?b ?a ?c)))
  (ok (equal (substitute-bindings '(p ?x ?y 3) '((?x . 1) (?y . "s"))) '(p 1 "s" 3)))
  (ok (equal (substitute-bindings '(p ?x ?z) '((?x . 1))) '(p 1 ?z)))
  (ok (builtin-literal-p '(< ?x 3)))
  (ok (builtin-literal-p '(glob "*.lisp" ?f)))
  (ok (not (builtin-literal-p '(edge 1 2))))
  (ok (not (builtin-literal-p '(< 1 2 3)))))

(deftest-parametrize term-order
    ((a b less)
     (1 2 t)
     (2 1 nil)
     (1 1 nil)
     (-5 3 t)
     (100 "a" t)
     ("a" 100 nil)
     ("a" "b" t)
     ("B" "a" t)
     ("a" "a" nil)
     ("zzz" :a t)
     (:a "zzz" nil)
     (:a :b t)
     (:b :a nil)
     (:email :terms t)
     (:a 'a t)
     ('a :a nil)
     ('apple :banana t)
     (:a :a nil))
  (ok (eq (and (term< a b) t) less)))

(deftest-parametrize fact-order
    ((a b less)
     ('(edge 1 2) '(edge 1 3) t)
     ('(edge 1 3) '(edge 1 2) nil)
     ('(edge 1) '(edge 1 2) t)
     ('(edge 1 2) '(edge 1) nil)
     ('(a 9) '(b 1) t)
     ('(p "x") '(p :x) t)
     ('(p 2) '(p "1") t)
     ('(moved) '(moved) nil)
     ('(edge 1 2) '(edge 1 2) nil))
  (ok (eq (and (fact< a b) t) less)))

(deftest sort-facts-dedupes-and-sorts
  (let* ((input (list '(path 2 3) '(edge 1 2) '(path 1 2) '(edge 1 2) '(path 1 10)))
         (copy (copy-list input)))
    (ok (equal (sort-facts input)
               '((edge 1 2) (path 1 2) (path 1 10) (path 2 3))))
    (ok (equal input copy) "the argument is not modified")
    (ok (null (sort-facts '())))))
