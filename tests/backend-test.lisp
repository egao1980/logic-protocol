(in-package #:logic-protocol/tests)

(deftest no-backend-signals
  (let ((*logic-backend* nil))
    (ok (signals (make-program) 'logic-no-backend))
    (ok (signals-with-restarts (logic-no-backend use-backend) (make-program)))
    (let* ((mock (make-mock))
           (p (handler-bind ((logic-no-backend (lambda (c) (use-backend mock c))))
                (make-program))))
      (ok (typep p 'program))
      (ok (eq (program-backend p) mock)))))

(deftest make-program-uses-special-and-argument
  (let* ((a (make-mock :name :a))
         (b (make-mock :name :b))
         (*logic-backend* a))
    (ok (eq (program-backend (make-program)) a))
    (ok (eq (program-backend (make-program :backend b)) b))
    (ok (= (program-time (make-program)) 0))))

(deftest make-program-rules-and-facts
  (let ((p (make-program :backend (make-mock)
                         :rules '((rule (a ?x) :- (b ?x)))
                         :facts '((b 2) (b 1)))))
    (ok (= (length (program-rules p)) 1))
    (ok (equal (program-base-facts p) '((b 1) (b 2))))))

(deftest-parametrize unsupported-rule-kinds
    ((features form feature)
     ('() '(rule (next (p ?x)) :- (q ?x)) :time-step)
     ('() '(rule (p ?x) :- (q ?x) (not (r ?x))) :stratified-negation)
     ('(:stratified-negation :time-step) '(rule (choice 1 1 (p ?x)) :- (q ?x)) :choice)
     ('(:stratified-negation :time-step) '(rule :- (p ?x) (q ?x)) :constraint)
     ;; unsupported is checked before safety
     ('() '(rule (next (p ?x)) :- (q ?y)) :time-step))
  (let* ((mock (make-mock :features features))
         (p (make-program :backend mock)))
    (ok (signals (add-rule p form) 'logic-unsupported-rule))
    (ok (handler-case (progn (add-rule p form) nil)
          (logic-unsupported-rule (c)
            (and (eq (logic-error-feature c) feature)
                 (eq (logic-error-backend c) mock)
                 (equal (rule-form (logic-error-rule c)) form)))))
    (ok (signals-with-restarts (logic-unsupported-rule drop-rule use-backend)
          (add-rule p form)))
    (ok (null (program-rules p)))))

(deftest unsupported-rule-use-backend
  (let* ((full (make-mock :name :full
                          :features '(:stratified-negation :time-step :choice :constraint)))
         (p (mock-program :features '())))
    (handler-bind ((logic-unsupported-rule (lambda (c) (use-backend full c))))
      (add-rules p '((rule (a ?x) :- (b ?x))
                     (rule (choice 1 1 (p ?x)) :- (q ?x)))))
    (ok (eq (program-backend p) full))
    (ok (equal (mapcar #'rule-form (mock-state-rules (program-state p)))
               '((rule (a ?x) :- (b ?x)) (rule (choice 1 1 (p ?x)) :- (q ?x)))))))

(deftest tick-needs-time-step
  (let ((p (mock-program :features '())))
    (ok (signals (tick p) 'logic-unsupported-rule))
    (ok (handler-case (progn (tick p) nil)
          (logic-unsupported-rule (c)
            (and (null (logic-error-rule c)) (eq (logic-error-feature c) :time-step))))))
  (let ((p (mock-program)))
    (update p :assert '((s 1)))
    (let ((d (tick p)))
      (ok (typep d 'delta))
      (ok (equal (delta-removed d) '((s 1)))))
    (ok (= (program-time p) 1))
    (tick p)
    (ok (= (program-time p) 2))))

(deftest update-validates-facts
  (dolist (bad '((p ?x) (p (f 1)) (not (p 1)) (< 1 2) 3 "p" nil))
    (let ((p (mock-program)))
      (ok (signals (update p :assert (list bad)) 'logic-syntax-error))
      (ok (signals (update p :retract (list bad)) 'logic-syntax-error))
      (ok (signals (assert-fact p bad) 'logic-syntax-error))
      (ok (null (calls-of (program-backend p) :update)) "the backend is not called"))))

(deftest update-dedupes-and-sorts
  (let* ((p (mock-program))
         (mock (program-backend p))
         (d (update p :assert '((p 2) (p 1) (p 2) (p 3)))))
    (ok (equal (delta-added d) '((p 1) (p 2) (p 3))) "sorted")
    (ok (null (delta-removed d)))
    (let ((call (last-call mock :update)))
      (ok (eq (first call) :update))
      (ok (= (length (second call)) 3) "duplicates dropped before the backend"))
    (let ((d2 (update p :retract '((p 3) (p 1)) :assert '((p 0)))))
      (ok (equal (delta-added d2) '((p 0))))
      (ok (equal (delta-removed d2) '((p 1) (p 3)))))
    (ok (equal (program-base-facts p) '((p 0) (p 2))))
    (ok (equal (program-facts p) '((p 0) (p 2))))
    (assert-fact p '(q 1))
    (retract-fact p '(p 0))
    (ok (equal (program-facts p) '((p 2) (q 1))))
    (ok (equal (program-facts p :relation 'q) '((q 1))))
    (ok (equal (program-base-facts p :relation 'p) '((p 2))))))

(deftest query-normalizes-answers
  (let* ((mock (make-mock :answers '(((?x . 2) (?y . 1))
                                     ((?y . 1) (?x . 1))
                                     ((?x . 2) (?y . 1))
                                     ((?y . "a") (?x . 1)))))
         (p (make-program :backend mock)))
    (ok (equal (query p '(r ?y ?x))
               '(((?y . 1) (?x . 1))
                 ((?y . 1) (?x . 2))
                 ((?y . "a") (?x . 1))))
        "variable order of the pattern, sorted by values, no duplicates")
    (ok (equal (query p '(r ?y ?x) :limit 2)
               '(((?y . 1) (?x . 1)) ((?y . 1) (?x . 2)))))
    (ok (equal (query p '(r ?y ?x) :limit 0) '()))
    (ok (holds-p p '(r ?y ?x)))
    (ok (equal (second (last-call mock :query)) '((r ?y ?x)))
        "an atom pattern reaches the backend as a one-literal list")
    (query p '(and (r ?y ?x) (not (s ?x))))
    (ok (equal (second (last-call mock :query)) '((r ?y ?x) (not (s ?x)))))))

(deftest query-ground-and-empty
  (let ((p (make-program :backend (make-mock :answers '(())))))
    (ok (equal (query p '(r 1 2)) '(nil)))
    (ok (holds-p p '(r 1 2))))
  (let ((p (make-program :backend (make-mock :answers '()))))
    (ok (null (query p '(r ?x))))
    (ok (not (holds-p p '(r ?x))))))

(deftest query-checks-pattern
  (let ((p (mock-program)))
    (ok (signals (query p '(and (r ?x) (not (s ?y)))) 'logic-unsafe-rule))
    (ok (handler-case (progn (query p '(and (r ?x) (not (s ?y)))) nil)
          (logic-unsafe-rule (c)
            (and (null (logic-error-rule c))
                 (equal (logic-error-form c) '(and (r ?x) (not (s ?y))))
                 (equal (logic-error-variables c) '(?y))))))
    (ok (signals (query p '(r (f 1))) 'logic-syntax-error))
    (ok (signals (query p '(and)) 'logic-syntax-error))
    (ok (signals (query p 3) 'logic-syntax-error))
    (ok (null (remove :base-facts (call-names (program-backend p))))
        "the backend never saw a bad pattern")))

(deftest assume-is-temporary
  (let* ((p (mock-program))
         (mock (program-backend p)))
    (update p :assert '((base 1)))
    (setf (mock-calls mock) '())
    (query p '(r ?x) :assume '((a 1) (base 1)))
    (ok (equal (calls-of mock :update :query)
               '((:update ((a 1)) ())
                 (:query ((r ?x)))
                 (:update () ((a 1)))))
        "only facts that are not base facts are assumed, then withdrawn")
    (ok (equal (program-base-facts p) '((base 1))))
    (explain p '(a 1) :assume '((a 1)))
    (ok (equal (program-base-facts p) '((base 1))))
    (setf (mock-answers mock) '(((?x . 1))))
    (ok (holds-p p '(r ?x) :assume '((a 2))))
    (ok (equal (program-base-facts p) '((base 1))))))

(deftest assume-withdrawn-on-unwind
  (let* ((mock (make-mock :answers '(((?x . 1)) ((?x . 2)) ((?x . 3))) :query-cost 5))
         (p (make-program :backend mock)))
    (update p :assert '((base 1)))
    (ok (eq (handler-bind ((logic-budget-exceeded (lambda (c) (use-value :stopped c))))
              (query p '(r ?x) :budget 3 :assume '((a 1))))
            :stopped))
    (ok (equal (program-base-facts p) '((base 1))))))

(deftest explain-checks-fact
  (let ((p (mock-program)))
    (ok (signals (explain p '(p ?x)) 'logic-syntax-error))
    (update p :assert '((p 1)))
    (ok (typep (explain p '(p 1)) 'proof))
    (ok (typep (explain p '(p 2)) 'why-not))))
